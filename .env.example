# 말랑톡 서버 설정. 이 파일을 .env로 복사해서 값을 채워요. (.env는 GitHub에 올라가지 않아요)
# 쓰는 AI 회사 키만 넣으면 돼요. 비워 둔 회사는 앱에서 내 키(BYOK)로만 쓸 수 있어요.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 정해 두면 앱 설정에서 이 코드를 넣어야 AI를 부를 수 있어요. 집 밖에서도 열리는 주소라면 꼭 정해 주세요.
ACCESS_CODE=

# 서버 포트. NAS에서 이미 쓰는 포트와 겹치면 비어 있는 번호로 바꿔요 (docker-compose도 이 값을 따라감)
PORT=5200
