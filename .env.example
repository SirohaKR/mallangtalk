# 말랑톡 서버 설정. 이 파일을 .env로 복사해서 값을 채워요. (.env는 GitHub에 올라가지 않아요)

# 서버 키로 AI를 대신 불러 줄지. 지금은 false(잠금)라서 각자 앱 설정에 자기 API 키를 넣어 써요.
# true로 바꾸면 아래 키로 서버가 대신 불러 줘요 (요금은 이 키의 계정에서 나가요)
USE_SERVER_AI_KEYS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# (서버 키를 켰을 때만) 정해 두면 앱 설정에서 이 코드를 넣어야 서버 키로 AI를 부를 수 있어요.
ACCESS_CODE=

# 로컬 SQLite 모드의 DB 폴더. 새 Compose의 PostgreSQL은 별도 Docker 볼륨에 보관돼요.
DATA_DIR=data

# Compose의 프론트 공개 포트. API 컨테이너 내부 포트는 5200으로 고정돼요.
PORT=5200

# PostgreSQL password: use a long random alphanumeric value (URL-safe).
POSTGRES_PASSWORD=
# Separate API origin for Flutter builds; empty uses /api on the frontend origin.
API_BASE_URL=
# Comma-separated frontend origins; needed only for direct cross-origin API access.
ALLOWED_ORIGINS=
