# 말랑톡 서버 설정. 이 파일을 .env로 복사해서 값을 채워요. (.env는 GitHub에 올라가지 않아요)

# 서버 키로 AI를 대신 불러 줄지. 지금은 false(잠금)라서 각자 앱 설정에 자기 API 키를 넣어 써요.
# true로 바꾸면 아래 키로 서버가 대신 불러 줘요 (요금은 이 키의 계정에서 나가요)
USE_SERVER_AI_KEYS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# (서버 키를 켰을 때만) 정해 두면 앱 설정에서 이 코드를 넣어야 서버 키로 AI를 부를 수 있어요.
ACCESS_CODE=

# 유저·캐릭터·사진 DB(mallangtalk.db)를 둘 폴더. docker-compose는 ./data 폴더에 저장돼요
DATA_DIR=data

# 서버 포트. NAS에서 이미 쓰는 포트와 겹치면 비어 있는 번호로 바꿔요 (docker-compose도 이 값을 따라감)
PORT=5200
